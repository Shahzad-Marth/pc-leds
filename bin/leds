#!/usr/bin/env bash
# =============================================================================
#  pc-leds - control PC RGB LEDs (motherboard ARGB + RAM) via OpenRGB
# -----------------------------------------------------------------------------
#  Usage:  leds {on|off|toggle|status|setup|gui}
#
#  Config:  ~/.config/pc-leds/config   (created by install.sh)
# =============================================================================
set -uo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/pc-leds"
CONFIG_FILE="$CONFIG_DIR/config"
STATE_FILE="$CONFIG_DIR/state"
SUPPORT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/pc-leds"
REPO_URL_TARBALL="https://codeload.github.com/Shahzad-Marth/pc-leds/tar.gz/refs/heads/main"
mkdir -p "$CONFIG_DIR" 2>/dev/null || true

# ---- defaults (overridden by the config file) -------------------------------
ON_COLOR="ffffff"     # colour used by 'on'  (RRGGBB)
ARGB_SIZE="128"       # LEDs per addressable header (raise for long strips)
ARGB_ZONES=""         # optional explicit zone indexes (e.g. "0 1 2"); empty = auto
WAIT_MAX="15"         # seconds to wait for devices to appear

# ---- config (parsed safely: values may carry inline '#' comments) -----------
readcfg() {   # key default
  [ -r "$CONFIG_FILE" ] || { printf '%s' "$2"; return; }
  local v; v="$(sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CONFIG_FILE" | tail -n1)"
  v="${v%%#*}"; v="${v//\"/}"; v="$(printf '%s' "$v" | sed 's/[[:space:]]*$//')"
  [ -n "$v" ] && printf '%s' "$v" || printf '%s' "$2"
}
ON_COLOR="$(readcfg ON_COLOR "$ON_COLOR")"
ARGB_SIZE="$(readcfg ARGB_SIZE "$ARGB_SIZE")"
ARGB_ZONES="$(readcfg ARGB_ZONES "$ARGB_ZONES")"

QUIET="${LEDS_QUIET:-0}"
OPENRGB="${PCLEDS_OPENRGB:-$(command -v openrgb || echo "$HOME/.local/bin/openrgb")}"

run()    { "$OPENRGB" --noautoconnect "$@" >/dev/null 2>&1; }
notify() { [ "$QUIET" = 1 ] && return 0
           command -v notify-send >/dev/null 2>&1 && notify-send "PC LEDs" "$1" 2>/dev/null
           return 0; }
say()    { [ "$QUIET" = 1 ] && return 0; echo "$@"; }

list_devices() { "$OPENRGB" --noautoconnect -l 2>/dev/null; }

need_openrgb() {
  [ -x "$OPENRGB" ] && return 0
  echo "pc-leds: OpenRGB not found - run 'leds setup' to install it" >&2
  exit 1
}

wait_devices() {
  local i
  for i in $(seq 1 "$WAIT_MAX"); do
    list_devices | grep -qE '^[0-9]+: ' && return 0
    sleep 1
  done
  return 1
}

# Emit one line per device: idx \t name \t type \t modes \t zones
parse_devices() {
  list_devices | awk '
    /^[0-9]+: / {
      if (idx != "") print idx "\t" name "\t" type "\t" modes "\t" zones;
      idx=$1; sub(/:$/, "", idx); sub(/^[0-9]+:[ \t]*/, ""); name=$0; type=""; modes=""; zones=""; next
    }
    /^[[:space:]]*Type:/  { sub(/^[[:space:]]*Type:[[:space:]]*/,  ""); type=$0;  next }
    /^[[:space:]]*Modes:/ { sub(/^[[:space:]]*Modes:[[:space:]]*/, ""); modes=$0; next }
    /^[[:space:]]*Zones:/ { sub(/^[[:space:]]*Zones:[[:space:]]*/, ""); zones=$0; next }
    END { if (idx != "") print idx "\t" name "\t" type "\t" modes "\t" zones }
  '
}

# Size addressable (ARGB) zones on the motherboard so a colour reaches them.
size_argb_zones() {
  local devs idx name type modes zones zi zname z
  devs="$(parse_devices)"
  while IFS=$'\t' read -r idx name type modes zones; do
    [ "$type" = "Motherboard" ] || continue
    zi=0
    for zname in $zones; do
      if printf '%s' "$zname" | grep -qiE 'argb|addr'; then
        run -d "$idx" -z "$zi" -sz "$ARGB_SIZE" -m Direct -c 000000
      fi
      zi=$((zi + 1))
    done
    for z in ${ARGB_ZONES//,/ }; do
      [ -n "$z" ] && run -d "$idx" -z "$z" -sz "$ARGB_SIZE" -m Direct -c 000000
    done
  done <<< "$devs"
}

leds_off() {
  need_openrgb
  if ! wait_devices; then
    say "pc-leds: no OpenRGB devices detected"
    exit 3            # lets the systemd service retry before giving up
  fi
  size_argb_zones
  local devs idx name type modes zones
  devs="$(parse_devices)"
  # 1) paint every device black in Direct mode (works even if it was in an effect)
  while IFS=$'\t' read -r idx name type modes zones; do
    if printf '%s' "$modes" | grep -q 'Direct'; then
      run -d "$idx" -m Direct -c 000000
    else
      run -d "$idx" -c 000000
    fi
  done <<< "$devs"
  # 2) use the controller's native "Off" mode where it exists (e.g. ENE DRAM)
  while IFS=$'\t' read -r idx name type modes zones; do
    case " $modes " in *" Off "*|*"[Off]"*) run -d "$idx" -m Off ;; esac
  done <<< "$devs"
  printf 'off\n' > "$STATE_FILE" 2>/dev/null || true
  notify "OFF"
  say "LEDs: OFF"
}

leds_on() {
  need_openrgb
  wait_devices || say "pc-leds: no OpenRGB devices detected"
  size_argb_zones
  local devs idx name type modes zones
  devs="$(parse_devices)"
  # switch every device to Direct and set the colour (a bare -c won't leave an
  # effect/Off mode, which is why the RAM used to stay dark).
  while IFS=$'\t' read -r idx name type modes zones; do
    if printf '%s' "$modes" | grep -q 'Direct'; then
      run -d "$idx" -m Direct -c "$ON_COLOR"
    else
      run -d "$idx" -c "$ON_COLOR"
    fi
  done <<< "$devs"
  printf 'on\n' > "$STATE_FILE" 2>/dev/null || true
  notify "ON"
  say "LEDs: ON ($ON_COLOR)"
}

# --------------------------------------------------------------- rainbow -----
modes_list() {   # one mode per line (drops quotes and [active] brackets)
  printf '%s\n' "$1" | grep -oE "'[^']+'|[A-Za-z0-9]+" | tr -d "'"
}

pick_mode() {    # modes candidate...  -> first candidate that the device offers
  local modes="$1"; shift
  local want tok
  for want in "$@"; do
    while IFS= read -r tok; do
      [ "$tok" = "$want" ] && { printf '%s' "$want"; return 0; }
    done <<< "$(modes_list "$modes")"
  done
  return 1
}

leds_rainbow() {
  need_openrgb
  if ! wait_devices; then
    say "pc-leds: no OpenRGB devices detected"
    exit 3
  fi
  size_argb_zones
  local devs idx name type modes zones mode
  devs="$(parse_devices)"
  # use each device's native animated rainbow/colour-cycle mode (hardware driven)
  while IFS=$'\t' read -r idx name type modes zones; do
    mode="$(pick_mode "$modes" Rainbow 'Spectrum Cycle' 'Color Cycle' Spectrum 'Rainbow Wave' || true)"
    if [ -n "$mode" ]; then
      run -d "$idx" -m "$mode"
    elif printf '%s' "$modes" | grep -q 'Direct'; then
      run -d "$idx" -m Direct -c "$ON_COLOR"   # no rainbow mode: show ON colour
    fi
  done <<< "$devs"
  printf 'on\n' > "$STATE_FILE" 2>/dev/null || true
  notify "Rainbow"
  say "LEDs: rainbow"
}

# ---------------------------------------------------------------- setup ------
find_installer() {
  local c
  for c in "${PCLEDS_INSTALLER:-}" \
           "$SUPPORT_DIR/install.sh" \
           "$(dirname "$(readlink -f "$0")")/../install.sh" \
           "$HOME/pc-leds/install.sh"; do
    [ -n "$c" ] && [ -f "$c" ] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

fetch_repo() {   # download the repo tarball; echo the extracted install.sh path
  local tmp; tmp="$(mktemp -d)" || return 1
  if curl -fsSL "$REPO_URL_TARBALL" | tar -xz -C "$tmp" --strip-components=1 2>/dev/null && [ -f "$tmp/install.sh" ]; then
    printf '%s' "$tmp/install.sh"
  else
    rm -rf "$tmp"; return 1
  fi
}

launch_terminal() {   # $1 = shell command string
  local cmd="$1" t
  for t in ptyxis gnome-terminal kgx konsole alacritty kitty foot wezterm xterm xfce4-terminal mate-terminal tilix; do
    command -v "$t" >/dev/null 2>&1 || continue
    case "$t" in
      ptyxis|gnome-terminal|kgx) exec "$t" -- bash -c "$cmd; exec bash" ;;
      konsole|alacritty|xterm|xfce4-terminal|mate-terminal|tilix) exec "$t" -e bash -c "$cmd; exec bash" ;;
      kitty|foot) exec "$t" bash -c "$cmd; exec bash" ;;
      wezterm) exec "$t" start -- bash -c "$cmd; exec bash" ;;
    esac
  done
  return 1
}

run_setup() {
  local installer; installer="$(find_installer || true)"
  if [ -z "$installer" ]; then
    say "pc-leds: fetching installer..."
    installer="$(fetch_repo || true)"
  fi
  [ -n "$installer" ] || { echo "pc-leds: cannot find or download the installer" >&2; exit 1; }
  if [ -t 0 ] && [ -t 1 ]; then
    exec bash "$installer" "$@"
  fi
  if launch_terminal "bash $(printf '%q' "$installer") $*"; then
    exit 0
  fi
  echo "pc-leds: no terminal found. Run manually:" >&2
  echo "  sudo bash $installer" >&2
  exit 1
}

# ----------------------------------------------------------------- gui -------
run_gui() {
  local g
  for g in "$HOME/.local/bin/pc-leds-gui" "$SUPPORT_DIR/bin/pc-leds-gui"; do
    [ -x "$g" ] && { exec "$g" "$@"; }
  done
  echo "pc-leds: GUI not installed - run 'leds setup'" >&2
  exit 1
}

case "${1:-toggle}" in
  off)    leds_off ;;
  on)     leds_on ;;
  rainbow) leds_rainbow ;;
  toggle) [ "$(cat "$STATE_FILE" 2>/dev/null)" = off ] && leds_on || leds_off ;;
  status|list)
    need_openrgb
    list_devices
    ;;
  setup)  shift || true; run_setup "$@" ;;
  gui)    shift || true; run_gui "$@" ;;
  -h|--help|help)
    cat <<EOF
pc-leds - control PC RGB LEDs via OpenRGB

  leds on        set every detected device to $ON_COLOR
  leds off       turn everything off (black / native Off mode)
  leds rainbow   animate every device with its native rainbow/colour-cycle
  leds toggle    flip between on and off
  leds status    list the devices OpenRGB can see
  leds setup     install OpenRGB + system configuration (distro-aware)
  leds gui       open the PC LEDs graphical app

Config file: $CONFIG_FILE
  ON_COLOR=RRGGBB   ARGB_SIZE=N   ARGB_ZONES="0 1 2"
EOF
    ;;
  *) echo "Usage: leds {on|off|toggle|rainbow|status|setup|gui}" >&2; exit 1 ;;
esac
