#!/usr/bin/python3
# =============================================================================
#  PC LEDs - a small GTK4/libadwaita front-end for pc-leds / OpenRGB
# -----------------------------------------------------------------------------
#  * ON / OFF for everything, with a colour picker
#  * per-device switches (uses the controller's native Off mode when present)
#  * "Install / Configure" installs OpenRGB + system setup for this distro,
#    via PolicyKit (pkexec) - no terminal required.
#
#  Runs on the system Python (needs python3-gobject, gtk4, libadwaita).
# =============================================================================
import colorsys
import os
import re
import shlex
import shutil
import subprocess
import sys
import threading

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Adw, Gdk, Gio, GLib  # noqa: E402

APP_ID = "io.github.shahzadmarth.PcLeds"
VERSION = "1.0"

HOME = os.path.expanduser("~")
CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "pc-leds")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config")
STATE_FILE = os.path.join(CONFIG_DIR, "state")   # written by the 'leds' CLI (on/off)
SUPPORT_DIR = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local", "share")), "pc-leds")

DEFAULT_ON = "ffffff"
DEFAULT_ARGB = "128"
RAINBOW_MODES = ["Rainbow", "Spectrum Cycle", "Color Cycle", "Spectrum", "Rainbow Wave"]


# --------------------------------------------------------------- helpers -----
def hex_to_rgba(value):
    h = value.strip().lstrip("#")
    if len(h) == 3:
        h = "".join(c * 2 for c in h)
    if len(h) != 6:
        h = DEFAULT_ON
    r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    return Gdk.RGBA(red=r / 255.0, green=g / 255.0, blue=b / 255.0, alpha=1.0)


def rgba_to_hex(rgba):
    return "%02x%02x%02x" % (
        max(0, min(255, round(rgba.red * 255))),
        max(0, min(255, round(rgba.green * 255))),
        max(0, min(255, round(rgba.blue * 255))),
    )


def find_openrgb():
    cands = [
        os.environ.get("PCLEDS_OPENRGB"),
        shutil.which("openrgb"),
        os.path.join(HOME, ".local", "bin", "openrgb"),
        "/usr/local/bin/openrgb",
        "/usr/bin/openrgb",
        "/opt/openrgb/AppRun",
    ]
    for c in cands:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def find_leds():
    for c in [os.path.join(HOME, ".local", "bin", "leds"), os.path.join(SUPPORT_DIR, "bin", "leds")]:
        if os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def find_support(*rel):
    here = os.path.dirname(os.path.realpath(__file__))
    cands = [os.path.join(SUPPORT_DIR, *rel), os.path.normpath(os.path.join(here, "..", *rel))]
    for c in cands:
        if os.path.isfile(c):
            return c
    return None


def read_config():
    cfg = {"ON_COLOR": DEFAULT_ON, "ARGB_SIZE": DEFAULT_ARGB, "ARGB_ZONES": ""}
    try:
        with open(CONFIG_FILE, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                v = v.split("#", 1)[0].strip().strip('"')
                cfg[k.strip()] = v
    except OSError:
        pass
    return cfg


def read_leds_state():
    """Return 'on'/'off' as last written by the leds CLI, else None."""
    try:
        with open(STATE_FILE, encoding="utf-8") as fh:
            val = fh.read().strip()
    except OSError:
        return None
    return val if val in ("on", "off") else None


def write_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_FILE, "w", encoding="utf-8") as fh:
        fh.write("# pc-leds configuration\n")
        fh.write('ON_COLOR="%s"\n' % cfg.get("ON_COLOR", DEFAULT_ON))
        fh.write('ARGB_SIZE="%s"\n' % cfg.get("ARGB_SIZE", DEFAULT_ARGB))
        fh.write('ARGB_ZONES="%s"\n' % cfg.get("ARGB_ZONES", ""))


def list_devices(openrgb):
    if not openrgb:
        return []
    try:
        out = subprocess.run(
            [openrgb, "--noautoconnect", "-l"],
            capture_output=True, text=True, timeout=25,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    devs, cur = [], None
    for line in out.splitlines():
        m = re.match(r"^(\d+):\s*(.*)$", line)
        if m:
            cur = {"index": int(m.group(1)), "name": m.group(2).strip(),
                   "type": "", "modes": [], "zones": []}
            devs.append(cur)
            continue
        if cur is None:
            continue
        s = line.strip()
        if s.startswith("Type:"):
            cur["type"] = s[5:].strip()
        elif s.startswith("Modes:"):
            try:
                cur["modes"] = shlex.split(s[6:].strip())
            except ValueError:
                cur["modes"] = s[6:].split()
        elif s.startswith("Zones:"):
            cur["zones"] = s[6:].split()
    return devs


def active_mode(modes):
    for m in modes:
        if len(m) >= 2 and m.startswith("[") and m.endswith("]"):
            return m[1:-1]
    return None


def friendly_type(kind):
    return {"DRAM": "RAM"}.get(kind, kind)


def pick_mode(modes, candidates=RAINBOW_MODES):
    """First candidate the device lists (mode names may carry [] or quotes)."""
    names = {m.strip("[]'") for m in modes}
    for cand in candidates:
        if cand in names:
            return cand
    return None


def hsv_to_hex(hue, sat=1.0, val=1.0):
    r, g, b = colorsys.hsv_to_rgb((hue % 360.0) / 360.0, sat, val)
    return "%02x%02x%02x" % (round(r * 255), round(g * 255), round(b * 255))


def group_devices(devices):
    """Collapse devices that share a type into one row (e.g. all RAM sticks)."""
    by_type, order = {}, []
    for d in devices:
        key = d["type"] or d["name"]
        if key not in by_type:
            by_type[key] = []
            order.append(key)
        by_type[key].append(d)
    groups = []
    for key in order:
        devs = by_type[key]
        if len(devs) == 1:
            d = devs[0]
            sub = d["type"] or None
            if d["modes"]:
                sub = "%s \u00b7 %s" % (d["type"] or "device", ", ".join(d["modes"][:4]))
            groups.append({"title": d["name"], "subtitle": sub, "devices": devs})
        else:
            sub = "%d units \u00b7 %s" % (len(devs), ", ".join(devs[0]["modes"][:4]) or friendly_type(key))
            groups.append({"title": friendly_type(key), "subtitle": sub, "devices": devs})
    return groups


def run_async(fn, done=None):
    def worker():
        err = None
        try:
            fn()
        except Exception as exc:  # noqa: BLE001
            err = exc
        if done is not None:
            GLib.idle_add(done, err)
    threading.Thread(target=worker, daemon=True).start()


# ----------------------------------------------------------------- window ----
class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="PC LEDs")
        self.set_default_size(540, 700)

        self.openrgb = find_openrgb()
        self.leds = find_leds()
        self.cfg = read_config()
        self.on_color_hex = self.cfg.get("ON_COLOR", DEFAULT_ON)
        self.leds_state = read_leds_state()
        self.dev_rows = []
        self.devices = []
        # index -> last state we set (a bare Direct-black device still reads
        # "Direct" from OpenRGB, so we can't infer on/off from the mode alone)
        self.dev_state = {}
        self._rainbow_stop = None
        self.connect("close-request", lambda *_: (self.stop_rainbow(), False)[1])

        self.toast = Adw.ToastOverlay()
        toolbar = Adw.ToolbarView()

        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(title="PC LEDs", subtitle="OpenRGB control"))
        refresh = Gtk.Button(icon_name="view-refresh-symbolic")
        refresh.set_tooltip_text("Re-detect devices")
        refresh.connect("clicked", lambda *_: self.refresh())
        header.pack_start(refresh)

        menu = Gio.Menu()
        menu.append("Install / Configure\u2026", "win.setup")
        menu.append("About PC LEDs", "win.about")
        header.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu))
        toolbar.add_top_bar(header)

        page = Adw.PreferencesPage()

        # --- All devices -----------------------------------------------------
        g_all = Adw.PreferencesGroup(title="All Devices")

        color_row = Adw.ActionRow(title="On colour", subtitle="Colour used by ON / 'leds on'")
        self.color_btn = Gtk.ColorDialogButton.new(Gtk.ColorDialog())
        self.color_btn.set_rgba(hex_to_rgba(self.on_color_hex))
        self.color_btn.set_valign(Gtk.Align.CENTER)
        self.color_btn.set_tooltip_text("Pick the ON colour")
        self.color_btn.connect("notify::rgba", self._on_color_changed)
        color_row.add_suffix(self.color_btn)
        g_all.add(color_row)

        big_row = Adw.ActionRow(title="All LEDs", subtitle="Apply to every detected device")
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, valign=Gtk.Align.CENTER)
        on_btn = Gtk.Button(label="ON")
        on_btn.add_css_class("suggested-action")
        on_btn.connect("clicked", lambda *_: self.do_all(True))
        off_btn = Gtk.Button(label="OFF")
        off_btn.add_css_class("destructive-action")
        off_btn.connect("clicked", lambda *_: self.do_all(False))
        rainbow_btn = Gtk.Button(label="Rainbow")
        rainbow_btn.set_tooltip_text("Animate every device with its native rainbow/colour-cycle")
        rainbow_btn.connect("clicked", lambda *_: self.do_rainbow())
        box.append(on_btn)
        box.append(off_btn)
        box.append(rainbow_btn)
        big_row.add_suffix(box)
        g_all.add(big_row)

        page.add(g_all)

        # --- Devices ---------------------------------------------------------
        self.dev_group = Adw.PreferencesGroup(title="Devices")
        page.add(self.dev_group)

        # --- Setup -----------------------------------------------------------
        g_setup = Adw.PreferencesGroup(title="Setup")
        self.status_row = Adw.ActionRow(title="OpenRGB")
        setup_btn = Gtk.Button(label="Install / Configure")
        setup_btn.add_css_class("pill")
        setup_btn.set_valign(Gtk.Align.CENTER)
        setup_btn.set_tooltip_text("Install OpenRGB and configure this system")
        setup_btn.connect("clicked", lambda *_: self.do_setup())
        self.status_row.add_suffix(setup_btn)
        g_setup.add(self.status_row)
        page.add(g_setup)

        toolbar.set_content(page)
        self.toast.set_child(toolbar)
        self.set_content(self.toast)

        act = Gio.SimpleAction.new("setup", None)
        act.connect("activate", lambda *_: self.do_setup())
        self.add_action(act)
        act = Gio.SimpleAction.new("about", None)
        act.connect("activate", lambda *_: self.show_about())
        self.add_action(act)

        self.refresh()

    # ---------------------------------------------------------- callbacks ----
    def _on_color_changed(self, btn, _pspec):
        self.on_color_hex = rgba_to_hex(btn.get_rgba())

    def _on_group_switch(self, _sw, state, group):
        self.stop_rainbow()
        for dev in group["devices"]:
            self.dev_state[dev["index"]] = state
        # if that leaves every device the same, keep the CLI state file in sync
        if self.devices and all(self.dev_state.get(d["index"]) == state for d in self.devices):
            self.leds_state = "on" if state else "off"
            try:
                with open(STATE_FILE, "w", encoding="utf-8") as fh:
                    fh.write(self.leds_state + "\n")
            except OSError:
                pass
        # keep the switch where the user put it: don't rebuild the rows here
        self.apply_async(lambda: [self.apply_device(d, state) for d in group["devices"]],
                         "%s: %s" % (group["title"], "ON" if state else "OFF"),
                         refresh=False)
        return False

    # ------------------------------------------------------------ actions ----
    def do_all(self, on):
        self.stop_rainbow()
        self.cfg["ON_COLOR"] = self.on_color_hex
        write_config(self.cfg)
        self.leds_state = "on" if on else "off"
        for dev in self.devices:          # every device follows the All button
            self.dev_state[dev["index"]] = on
        self.apply_async(lambda: self.apply_all(on), "All LEDs: %s" % ("ON" if on else "OFF"))

    def do_rainbow(self):
        self.stop_rainbow()
        self.leds_state = "on"
        for dev in self.devices:
            self.dev_state[dev["index"]] = True
        self.apply_async(lambda: self.apply_rainbow(), "All LEDs: Rainbow")

    def apply_all(self, on):
        if self.leds:
            subprocess.run([self.leds, "on" if on else "off"], capture_output=True, text=True)
            return
        if not self.openrgb:
            raise RuntimeError("OpenRGB not installed")
        # A bare -c will not leave an effect/Off mode; Direct is required.
        subprocess.run([self.openrgb, "--noautoconnect", "-m", "Direct", "-c",
                        self.on_color_hex if on else "000000"], capture_output=True, text=True)

    def apply_rainbow(self):
        if not self.openrgb:
            raise RuntimeError("OpenRGB not installed")
        software = []
        for dev in self.devices:
            mode = pick_mode(dev["modes"])
            applied = False
            if mode:                       # try the hardware effect first
                subprocess.run([self.openrgb, "--noautoconnect",
                                "-d", str(dev["index"]), "-m", mode],
                               capture_output=True, text=True)
                # some controllers list an effect but ignore it (the board stays
                # Direct), so confirm the active mode actually changed
                now = [d for d in list_devices(self.openrgb) if d["index"] == dev["index"]]
                applied = bool(now) and active_mode(now[0]["modes"]) == mode
            if not applied:                # no working effect: animate it ourselves
                software.append(dev)
        self.stop_rainbow()
        if software:
            ev = threading.Event()
            self._rainbow_stop = ev
            threading.Thread(target=self._rainbow_loop,
                             args=(software, ev), daemon=True).start()

    def _rainbow_loop(self, devices, stop):
        hue = 0.0
        while not stop.is_set():
            colour = hsv_to_hex(hue)
            for dev in devices:
                subprocess.run([self.openrgb, "--noautoconnect", "-d",
                                str(dev["index"]), "-m", "Direct", "-c", colour],
                               capture_output=True, text=True)
            hue = (hue + 6.0) % 360.0
            stop.wait(0.12)

    def stop_rainbow(self):
        ev = getattr(self, "_rainbow_stop", None)
        if ev is not None:
            ev.set()
            self._rainbow_stop = None

    def apply_device(self, dev, on):
        if not self.openrgb:
            raise RuntimeError("OpenRGB not installed")
        args = [self.openrgb, "--noautoconnect", "-d", str(dev["index"])]
        if on:
            if any(m.strip("[]") == "Direct" for m in dev["modes"]):
                args += ["-m", "Direct"]
            args += ["-c", self.on_color_hex]
        elif any(m.strip("[]") == "Off" for m in dev["modes"]):
            args += ["-m", "Off"]
        else:
            if any(m.strip("[]") == "Direct" for m in dev["modes"]):
                args += ["-m", "Direct"]
            args += ["-c", "000000"]
        subprocess.run(args, capture_output=True, text=True)

    def apply_async(self, fn, ok_msg, refresh=True):
        self.toast.add_toast(Adw.Toast(title="Working\u2026", timeout=1))

        def done(err):
            self.toast.add_toast(Adw.Toast(title=str(err) if err else ok_msg, timeout=3))
            if refresh:
                self.refresh()
        run_async(fn, done)

    def do_setup(self):
        syssh = find_support("scripts", "setup-system.sh")
        inst = find_support("install.sh")
        if not syssh and not inst:
            self.toast.add_toast(Adw.Toast(
                title="Setup files not found \u2013 run ./install.sh from the repo", timeout=5))
            return

        def work():
            if syssh:
                if shutil.which("pkexec"):
                    r = subprocess.run(["pkexec", "bash", syssh], capture_output=True, text=True)
                elif shutil.which("sudo"):
                    r = subprocess.run(["sudo", "bash", syssh], capture_output=True, text=True)
                else:
                    raise RuntimeError("need pkexec or sudo for system setup")
                if r.returncode not in (0, 10):
                    raise RuntimeError("system setup failed (see terminal)")
            if inst:
                subprocess.run(["bash", inst, "--skip-system"], capture_output=True, text=True)

        self.toast.add_toast(Adw.Toast(title="Installing\u2026 enter your password", timeout=2))
        self.apply_async(work, "Setup complete (reboot may be required)")

    def show_about(self):
        about = Adw.AboutWindow(transient_for=self, application_name="PC LEDs",
                                application_icon="video-display", version=VERSION,
                                comments="Control PC RGB LEDs (motherboard ARGB + RAM) via OpenRGB.",
                                website="https://github.com/Shahzad-Marth/pc-leds")
        about.set_developers(["Shahzad Marth"])
        about.present()

    # ------------------------------------------------------------ refresh ----
    def refresh(self):
        self.openrgb = find_openrgb()
        for row in self.dev_rows:
            self.dev_group.remove(row)
        self.dev_rows = []
        self.devices = list_devices(self.openrgb)

        if not self.openrgb:
            placeholder = Adw.ActionRow(title="OpenRGB not installed",
                                        subtitle="Use \u201cInstall / Configure\u201d above")
            self.dev_group.add(placeholder)
            self.dev_rows.append(placeholder)
        elif not self.devices:
            placeholder = Adw.ActionRow(title="No devices detected",
                                        subtitle="Check udev rules / permissions")
            self.dev_group.add(placeholder)
            self.dev_rows.append(placeholder)
        else:
            for group in group_devices(self.devices):
                row = Adw.ActionRow(title=group["title"], subtitle=group["subtitle"])
                sw = Gtk.Switch(valign=Gtk.Align.CENTER)
                for dev in group["devices"]:
                    if dev["index"] not in self.dev_state:
                        if self.leds_state is not None:
                            self.dev_state[dev["index"]] = (self.leds_state == "on")
                        else:
                            self.dev_state[dev["index"]] = active_mode(dev["modes"]) != "Off"
                sw.set_active(all(self.dev_state[dev["index"]] for dev in group["devices"]))
                sw.connect("state-set", self._on_group_switch, group)
                row.add_suffix(sw)
                row.set_activatable_widget(sw)
                self.dev_group.add(row)
                self.dev_rows.append(row)

        base = self.openrgb or "not installed"
        self.status_row.set_subtitle("%s%s" % (base,
                                 "  \u00b7  %d device(s)" % len(self.devices) if self.devices else ""))


class App(Adw.Application):
    smoke = False

    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_startup(self):
        Adw.Application.do_startup(self)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.PREFER_DARK)

    def do_activate(self):
        if self.smoke:
            Window(self)          # construct the whole UI, but never present it
            print("smoke: UI constructed OK (%d devices)" % len(list_devices(find_openrgb())))
            self.quit()
            return
        win = self.props.active_window or Window(self)
        win.present()


def self_test():
    print("openrgb:", find_openrgb())
    print("leds   :", find_leds())
    print("setup  :", find_support("scripts", "setup-system.sh"))
    for d in list_devices(find_openrgb()):
        print("  [%d] %s (%s) modes=%s zones=%s" %
              (d["index"], d["name"], d["type"], ",".join(d["modes"]), ",".join(d["zones"])))
    return 0


if __name__ == "__main__":
    if "--self-test" in sys.argv:
        sys.exit(self_test())
    if "--version" in sys.argv:
        print("pc-leds-gui %s" % VERSION)
        sys.exit(0)
    if "--smoke" in sys.argv:
        App.smoke = True
        sys.argv = [a for a in sys.argv if a != "--smoke"]
    sys.exit(App().run(sys.argv))
