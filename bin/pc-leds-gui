#!/usr/bin/python3
# =============================================================================
#  PC LEDs - a small GTK4/libadwaita front-end for pc-leds / OpenRGB
# -----------------------------------------------------------------------------
#  * ON / OFF for everything, with a colour picker
#  * per-device switches (uses the controller's native Off mode when present)
#  * "Install / Configure" installs OpenRGB + system setup for this distro,
#    via PolicyKit (pkexec) - no terminal required.
#
#  Runs on the system Python (needs python3-gobject, gtk4, libadwaita).
# =============================================================================
import colorsys
import os
import re
import shlex
import shutil
import socket
import struct
import subprocess
import sys
import threading
import time

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Adw, Gdk, Gio, GLib  # noqa: E402

APP_ID = "io.github.shahzadmarth.PcLeds"
VERSION = "1.0"

HOME = os.path.expanduser("~")
CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "pc-leds")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config")
STATE_FILE = os.path.join(CONFIG_DIR, "state")   # written by the 'leds' CLI (on/off)
SUPPORT_DIR = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local", "share")), "pc-leds")

DEFAULT_ON = "ffffff"
DEFAULT_ARGB = "128"
RAINBOW_MODES = ["Rainbow", "Spectrum Cycle", "Color Cycle", "Spectrum", "Rainbow Wave"]
OPENRGB_HOST = "127.0.0.1"
OPENRGB_PORT = 6742          # OpenRGB SDK server port ("ORGB")


# --------------------------------------------------------------- helpers -----
def hex_to_rgba(value):
    h = value.strip().lstrip("#")
    if len(h) == 3:
        h = "".join(c * 2 for c in h)
    if len(h) != 6:
        h = DEFAULT_ON
    r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    return Gdk.RGBA(red=r / 255.0, green=g / 255.0, blue=b / 255.0, alpha=1.0)


def rgba_to_hex(rgba):
    return "%02x%02x%02x" % (
        max(0, min(255, round(rgba.red * 255))),
        max(0, min(255, round(rgba.green * 255))),
        max(0, min(255, round(rgba.blue * 255))),
    )


def find_openrgb():
    cands = [
        os.environ.get("PCLEDS_OPENRGB"),
        shutil.which("openrgb"),
        os.path.join(HOME, ".local", "bin", "openrgb"),
        "/usr/local/bin/openrgb",
        "/usr/bin/openrgb",
        "/opt/openrgb/AppRun",
    ]
    for c in cands:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def find_leds():
    for c in [os.path.join(HOME, ".local", "bin", "leds"), os.path.join(SUPPORT_DIR, "bin", "leds")]:
        if os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def find_support(*rel):
    here = os.path.dirname(os.path.realpath(__file__))
    cands = [os.path.join(SUPPORT_DIR, *rel), os.path.normpath(os.path.join(here, "..", *rel))]
    for c in cands:
        if os.path.isfile(c):
            return c
    return None


def read_config():
    cfg = {"ON_COLOR": DEFAULT_ON, "ARGB_SIZE": DEFAULT_ARGB, "ARGB_ZONES": ""}
    try:
        with open(CONFIG_FILE, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                v = v.split("#", 1)[0].strip().strip('"')
                cfg[k.strip()] = v
    except OSError:
        pass
    return cfg


def read_leds_state():
    """Return 'on'/'off' as last written by the leds CLI, else None."""
    try:
        with open(STATE_FILE, encoding="utf-8") as fh:
            val = fh.read().strip()
    except OSError:
        return None
    return val if val in ("on", "off") else None


def write_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_FILE, "w", encoding="utf-8") as fh:
        fh.write("# pc-leds configuration\n")
        fh.write('ON_COLOR="%s"\n' % cfg.get("ON_COLOR", DEFAULT_ON))
        fh.write('ARGB_SIZE="%s"\n' % cfg.get("ARGB_SIZE", DEFAULT_ARGB))
        fh.write('ARGB_ZONES="%s"\n' % cfg.get("ARGB_ZONES", ""))


def list_devices(openrgb):
    if not openrgb:
        return []
    try:
        out = subprocess.run(
            [openrgb, "--noautoconnect", "-l"],
            capture_output=True, text=True, timeout=25,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    devs, cur = [], None
    for line in out.splitlines():
        m = re.match(r"^(\d+):\s*(.*)$", line)
        if m:
            cur = {"index": int(m.group(1)), "name": m.group(2).strip(),
                   "type": "", "modes": [], "zones": [], "led_count": 0}
            devs.append(cur)
            continue
        if cur is None:
            continue
        s = line.strip()
        if s.startswith("Type:"):
            cur["type"] = s[5:].strip()
        elif s.startswith("Modes:"):
            try:
                cur["modes"] = shlex.split(s[6:].strip())
            except ValueError:
                cur["modes"] = s[6:].split()
        elif s.startswith("Zones:"):
            cur["zones"] = s[6:].split()
        elif s.startswith("LEDs:"):
            try:
                cur["led_count"] = len(shlex.split(s[5:].strip()))
            except ValueError:
                pass
    return devs


def active_mode(modes):
    for m in modes:
        if len(m) >= 2 and m.startswith("[") and m.endswith("]"):
            return m[1:-1]
    return None


def friendly_type(kind):
    return {"DRAM": "RAM"}.get(kind, kind)


def pick_mode(modes, candidates=RAINBOW_MODES):
    """First candidate the device lists (mode names may carry [] or quotes)."""
    names = {m.strip("[]'") for m in modes}
    for cand in candidates:
        if cand in names:
            return cand
    return None


def hsv_to_hex(hue, sat=1.0, val=1.0):
    r, g, b = colorsys.hsv_to_rgb((hue % 360.0) / 360.0, sat, val)
    return "%02x%02x%02x" % (round(r * 255), round(g * 255), round(b * 255))


def server_running(host=OPENRGB_HOST, port=OPENRGB_PORT, timeout=0.3):
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


class OpenRgbSdk:
    """A tiny, stdlib-only OpenRGB SDK client.

    Sending colours through a persistent OpenRGB server is the only way to get
    a smooth software animation: each ``openrgb`` CLI run re-detects all the
    hardware (~1.5-2.5 s), whereas a single ``UPDATELEDS`` packet here costs
    well under a millisecond.
    """

    PROTO = 5   # highest protocol we implement (matches OpenRGB 1.0rc)

    def __init__(self, host=OPENRGB_HOST, port=OPENRGB_PORT, name="pc-leds", timeout=5.0):
        self.sock = socket.create_connection((host, port), timeout=timeout)
        self.sock.settimeout(timeout)
        self._negotiate(name)

    def _send(self, dev, pid, data=b""):
        self.sock.sendall(struct.pack("ccccIII", b"O", b"R", b"G", b"B", dev, pid, len(data)) + data)

    def _recv_exact(self, n):
        buf = b""
        while len(buf) < n:
            chunk = self.sock.recv(n - len(buf))
            if not chunk:
                raise ConnectionError("OpenRGB SDK connection closed")
            buf += chunk
        return buf

    def _read_packet(self):
        head = self._recv_exact(16)
        if head[:4] != b"ORGB":
            raise ConnectionError("bad OpenRGB SDK magic")
        dev, pid, size = struct.unpack("III", head[4:16])
        data = self._recv_exact(size) if size else b""
        return dev, pid, data

    def _negotiate(self, name):
        self._send(0, 40, struct.pack("I", self.PROTO))   # REQUEST_PROTOCOL_VERSION
        self.sock.settimeout(2.0)
        self.protocol = 0
        try:
            for _ in range(5):                            # skip any server chatter
                _dev, pid, data = self._read_packet()
                if pid == 40 and len(data) >= 4:
                    self.protocol = struct.unpack("I", data)[0]
                    break
        except (socket.timeout, ConnectionError, OSError):
            pass
        self.sock.settimeout(5.0)
        self._send(0, 50, name.encode("utf-8", "replace") + b"\0")   # SET_CLIENT_NAME

    def set_custom_mode(self, dev):
        self._send(dev, 1100)                              # SETCUSTOMMODE (Direct)

    def update_leds(self, dev, colors):
        body = struct.pack("H", len(colors)) + b"".join(
            struct.pack("BBBx", r, g, b) for r, g, b in colors)
        self._send(dev, 1050, struct.pack("I", 4 + len(body)) + body)

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass


def group_devices(devices):
    """Collapse devices that share a type into one row (e.g. all RAM sticks)."""
    by_type, order = {}, []
    for d in devices:
        key = d["type"] or d["name"]
        if key not in by_type:
            by_type[key] = []
            order.append(key)
        by_type[key].append(d)
    groups = []
    for key in order:
        devs = by_type[key]
        if len(devs) == 1:
            d = devs[0]
            sub = d["type"] or None
            if d["modes"]:
                sub = "%s \u00b7 %s" % (d["type"] or "device", ", ".join(d["modes"][:4]))
            groups.append({"title": d["name"], "subtitle": sub, "devices": devs})
        else:
            sub = "%d units \u00b7 %s" % (len(devs), ", ".join(devs[0]["modes"][:4]) or friendly_type(key))
            groups.append({"title": friendly_type(key), "subtitle": sub, "devices": devs})
    return groups


def run_async(fn, done=None):
    def worker():
        err = None
        try:
            fn()
        except Exception as exc:  # noqa: BLE001
            err = exc
        if done is not None:
            GLib.idle_add(done, err)
    threading.Thread(target=worker, daemon=True).start()


# ----------------------------------------------------------------- window ----
class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="PC LEDs")
        self.set_default_size(540, 700)

        self.openrgb = find_openrgb()
        self.leds = find_leds()
        self.cfg = read_config()
        self.on_color_hex = self.cfg.get("ON_COLOR", DEFAULT_ON)
        self.leds_state = read_leds_state()
        self.dev_rows = []
        self.switch_rows = []          # (switch, handler-id, group) for live sync
        self.devices = []
        # index -> last state we set (a bare Direct-black device still reads
        # "Direct" from OpenRGB, so we can't infer on/off from the mode alone)
        self.dev_state = {}
        self._rainbow_stop = None
        self._sdk = None               # OpenRgbSdk while a software rainbow runs
        self._server_proc = None       # OpenRGB server we started (if any)
        self._rainbow_plan = None      # idx -> ("native", mode) | ("software", None)
        self._native_applied = False   # have the native effects been set already?
        self._color_timer = 0
        self.connect("close-request", lambda *_: (self.shutdown(), False)[1])

        self.toast = Adw.ToastOverlay()
        toolbar = Adw.ToolbarView()

        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(title="PC LEDs", subtitle="OpenRGB control"))
        refresh = Gtk.Button(icon_name="view-refresh-symbolic")
        refresh.set_tooltip_text("Re-detect devices")
        refresh.connect("clicked", lambda *_: self.refresh())
        header.pack_start(refresh)

        menu = Gio.Menu()
        menu.append("Install / Configure\u2026", "win.setup")
        menu.append("About PC LEDs", "win.about")
        header.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu))
        toolbar.add_top_bar(header)

        page = Adw.PreferencesPage()

        # --- All devices -----------------------------------------------------
        g_all = Adw.PreferencesGroup(title="All Devices")

        color_row = Adw.ActionRow(title="On colour", subtitle="Colour used by ON / 'leds on'")
        self.color_btn = Gtk.ColorDialogButton.new(Gtk.ColorDialog())
        self.color_btn.set_rgba(hex_to_rgba(self.on_color_hex))
        self.color_btn.set_valign(Gtk.Align.CENTER)
        self.color_btn.set_tooltip_text("Pick the ON colour")
        self.color_btn.connect("notify::rgba", self._on_color_changed)
        color_row.add_suffix(self.color_btn)
        g_all.add(color_row)

        big_row = Adw.ActionRow(title="All LEDs", subtitle="Apply to every detected device")
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, valign=Gtk.Align.CENTER)
        on_btn = Gtk.Button(label="ON")
        on_btn.add_css_class("suggested-action")
        on_btn.connect("clicked", lambda *_: self.do_all(True))
        off_btn = Gtk.Button(label="OFF")
        off_btn.add_css_class("destructive-action")
        off_btn.connect("clicked", lambda *_: self.do_all(False))
        rainbow_btn = Gtk.Button(label="Rainbow")
        rainbow_btn.set_tooltip_text("Animate every device with its native rainbow/colour-cycle")
        rainbow_btn.connect("clicked", lambda *_: self.do_rainbow())
        box.append(on_btn)
        box.append(off_btn)
        box.append(rainbow_btn)
        big_row.add_suffix(box)
        g_all.add(big_row)

        page.add(g_all)

        # --- Devices ---------------------------------------------------------
        self.dev_group = Adw.PreferencesGroup(title="Devices")
        page.add(self.dev_group)

        # --- Setup -----------------------------------------------------------
        g_setup = Adw.PreferencesGroup(title="Setup")
        self.status_row = Adw.ActionRow(title="OpenRGB")
        setup_btn = Gtk.Button(label="Install / Configure")
        setup_btn.add_css_class("pill")
        setup_btn.set_valign(Gtk.Align.CENTER)
        setup_btn.set_tooltip_text("Install OpenRGB and configure this system")
        setup_btn.connect("clicked", lambda *_: self.do_setup())
        self.status_row.add_suffix(setup_btn)
        g_setup.add(self.status_row)
        page.add(g_setup)

        toolbar.set_content(page)
        self.toast.set_child(toolbar)
        self.set_content(self.toast)

        act = Gio.SimpleAction.new("setup", None)
        act.connect("activate", lambda *_: self.do_setup())
        self.add_action(act)
        act = Gio.SimpleAction.new("about", None)
        act.connect("activate", lambda *_: self.show_about())
        self.add_action(act)

        self.refresh()

    # ---------------------------------------------------------- callbacks ----
    def _on_color_changed(self, btn, _pspec):
        self.on_color_hex = rgba_to_hex(btn.get_rgba())
        self.cfg["ON_COLOR"] = self.on_color_hex
        write_config(self.cfg)
        # apply live when the LEDs are already on (debounced so dragging in the
        # colour dialog doesn't fire an OpenRGB call for every step)
        if self.leds_state == "on":
            self.stop_rainbow()
            if self._color_timer:
                GLib.source_remove(self._color_timer)
            self._color_timer = GLib.timeout_add(180, self._apply_color_now)

    def _apply_color_now(self):
        self._color_timer = 0
        self._native_applied = False
        for dev in self.devices:
            self.dev_state[dev["index"]] = True
        self.sync_switches()
        self.apply_async(lambda: self.apply_all(True),
                         "Colour: #%s" % self.on_color_hex, refresh=False)
        return False

    def _on_group_switch(self, _sw, state, group):
        self.stop_rainbow()
        self._native_applied = False
        for dev in group["devices"]:
            self.dev_state[dev["index"]] = state
        # if that leaves every device the same, keep the CLI state file in sync
        if self.devices and all(self.dev_state.get(d["index"]) == state for d in self.devices):
            self.leds_state = "on" if state else "off"
            try:
                with open(STATE_FILE, "w", encoding="utf-8") as fh:
                    fh.write(self.leds_state + "\n")
            except OSError:
                pass
        # keep the switch where the user put it: don't rebuild the rows here
        self.apply_async(lambda: self.apply_group(group["devices"], state),
                         "%s: %s" % (group["title"], "ON" if state else "OFF"),
                         refresh=False)
        return False

    def apply_group(self, devices, on):
        """Apply on/off to several devices in a single OpenRGB invocation."""
        if not self.openrgb:
            raise RuntimeError("OpenRGB not installed")
        args = [self.openrgb, "--noautoconnect"]
        for dev in devices:
            args += ["-d", str(dev["index"])]
            if on:
                if any(m.strip("[]") == "Direct" for m in dev["modes"]):
                    args += ["-m", "Direct"]
                args += ["-c", self.on_color_hex]
            elif any(m.strip("[]") == "Off" for m in dev["modes"]):
                args += ["-m", "Off"]
            else:
                if any(m.strip("[]") == "Direct" for m in dev["modes"]):
                    args += ["-m", "Direct"]
                args += ["-c", "000000"]
        subprocess.run(args, capture_output=True, text=True)

    # ------------------------------------------------------------ actions ----
    def do_all(self, on):
        self.stop_rainbow()
        self._native_applied = False
        self.cfg["ON_COLOR"] = self.on_color_hex
        write_config(self.cfg)
        self.leds_state = "on" if on else "off"
        for dev in self.devices:          # every device follows the All button
            self.dev_state[dev["index"]] = on
        self.sync_switches()
        self.apply_async(lambda: self.apply_all(on), "All LEDs: %s" % ("ON" if on else "OFF"),
                         refresh=False)

    def do_rainbow(self):
        self.stop_rainbow()
        self.leds_state = "on"
        for dev in self.devices:
            self.dev_state[dev["index"]] = True
        self.sync_switches()
        self.apply_async(lambda: self.apply_rainbow(), "All LEDs: Rainbow", refresh=False)

    def apply_all(self, on):
        if self.leds:
            subprocess.run([self.leds, "on" if on else "off"], capture_output=True, text=True)
            return
        if not self.openrgb:
            raise RuntimeError("OpenRGB not installed")
        # A bare -c will not leave an effect/Off mode; Direct is required.
        subprocess.run([self.openrgb, "--noautoconnect", "-m", "Direct", "-c",
                        self.on_color_hex if on else "000000"], capture_output=True, text=True)

    def apply_rainbow(self):
        if not self.openrgb:
            raise RuntimeError("OpenRGB not installed")
        # Bring the SDK server up first and let it detect hardware while we make
        # the native-effect CLI call, so the two overlap instead of stacking.
        warm = {}
        warmsrv = threading.Thread(
            target=lambda: warm.setdefault("proc", self._ensure_server()), daemon=True)
        warmsrv.start()
        if self._rainbow_plan is None:
            # first time: classify devices once (set effect + verify) and cache
            self._rainbow_plan = self._compute_rainbow_plan()
            self._native_applied = True
        elif not self._native_applied:
            self._apply_native_modes()
            self._native_applied = True
        plan = self._rainbow_plan
        self.stop_rainbow()
        software = [d for d in self.devices
                    if plan.get(d["index"], ("software", None))[0] == "software"]
        if software:
            warmsrv.join(timeout=16)       # don't race the server bring-up
            self._start_software_rainbow(software)

    # -- rainbow classification / native effects --------------------------
    def _set_native_modes(self, pairs):
        """Set several devices' effects in ONE openrgb call.  True if it ran."""
        args = [self.openrgb, "--noautoconnect"]
        for idx, mode in pairs:
            args += ["-d", str(idx), "-m", mode]
        if len(args) <= 2:
            return False
        subprocess.run(args, capture_output=True, text=True)
        return True

    def _compute_rainbow_plan(self):
        """Once per device list: work out which devices need software animation."""
        plan = {}
        would = []
        for dev in self.devices:
            mode = pick_mode(dev["modes"])
            if mode:
                plan[dev["index"]] = ("native", mode)
                would.append((dev["index"], mode))
            else:
                plan[dev["index"]] = ("software", None)
        if would:
            self._set_native_modes(would)
            # some controllers list an effect but silently ignore it (the board
            # stays Direct), so confirm the active mode actually changed
            now = {d["index"]: active_mode(d["modes"]) for d in list_devices(self.openrgb)}
            for idx, mode in would:
                if now.get(idx) != mode:
                    plan[idx] = ("software", None)
        return plan

    def _apply_native_modes(self):
        plan = self._rainbow_plan or {}
        pairs = [(idx, mode) for idx, (kind, mode) in plan.items()
                 if kind == "native" and mode]
        self._set_native_modes(pairs)

    # -- software rainbow -------------------------------------------------
    # The board lists effects but silently ignores them, so we animate it by
    # streaming colours.  Through the SDK server that runs at ~25 fps; without
    # a server we fall back to one-shot CLI calls (slow, but still animates).
    def _start_software_rainbow(self, devices):
        targets = [(d["index"], d.get("led_count", 0)) for d in devices
                   if d.get("led_count", 0) > 0]
        if not targets:
            self._start_cli_rainbow(devices)
            return
        sdk = self._get_sdk()
        if sdk is None:
            self._start_cli_rainbow(devices)
            return
        for idx, _n in targets:            # make sure each device is in Direct
            try:
                sdk.set_custom_mode(idx)
            except OSError:
                pass
        ev = threading.Event()
        self._rainbow_stop = ev
        threading.Thread(target=self._sdk_rainbow_loop,
                         args=(sdk, targets, ev), daemon=True).start()

    def _sdk_rainbow_loop(self, sdk, targets, stop):
        # a moving rainbow gradient across each device's LEDs
        span = max(n for _i, n in targets)
        offset = 0.0
        while not stop.is_set():
            for idx, n in targets:
                colors = []
                for i in range(n):
                    r, g, b = colorsys.hsv_to_rgb(((i / float(span)) + offset) % 1.0, 1.0, 1.0)
                    colors.append((round(r * 255), round(g * 255), round(b * 255)))
                try:
                    sdk.update_leds(idx, colors)
                except OSError:
                    return
            offset = (offset + 0.01) % 1.0
            stop.wait(0.04)                # ~25 fps

    def _start_cli_rainbow(self, devices):
        ev = threading.Event()
        self._rainbow_stop = ev
        threading.Thread(target=self._rainbow_loop, args=(devices, ev), daemon=True).start()

    def _rainbow_loop(self, devices, stop):
        # fallback when no SDK server is available: one-shot CLI (~2.5 s/frame)
        hue = 0.0
        while not stop.is_set():
            colour = hsv_to_hex(hue)
            args = [self.openrgb, "--noautoconnect"]
            for dev in devices:
                args += ["-d", str(dev["index"]), "-m", "Direct", "-c", colour]
            subprocess.run(args, capture_output=True, text=True)
            hue = (hue + 12.0) % 360.0
            stop.wait(0.12)

    # -- SDK server lifecycle ---------------------------------------------
    # The server is started once and kept alive for the whole GUI session (so
    # repeat Rainbow clicks are instant) and torn down on quit.  A server that
    # was already running (e.g. the OpenRGB GUI) is reused but never killed.
    def _ensure_server(self):
        if self._server_proc is not None and self._server_proc.poll() is None:
            return self._server_proc
        self._server_proc = None
        if server_running():
            return None
        if not self.openrgb:
            return None
        try:
            proc = subprocess.Popen(
                [self.openrgb, "--server", "--noautoconnect"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True)
        except OSError:
            return None
        self._server_proc = proc
        for _ in range(75):                # up to ~15 s for hardware detection
            if proc.poll() is not None:
                self._server_proc = None
                return None
            if server_running():
                return proc
            time.sleep(0.2)
        return proc

    def _get_sdk(self):
        if self._sdk is not None:
            return self._sdk
        self._ensure_server()
        try:
            self._sdk = OpenRgbSdk()
        except OSError:
            return None
        return self._sdk

    def stop_rainbow(self):
        """Stop any running animation; keep the server/SDK for a fast restart."""
        ev = getattr(self, "_rainbow_stop", None)
        if ev is not None:
            ev.set()
            self._rainbow_stop = None

    def shutdown(self):
        """Stop the animation and tear down the SDK server we started."""
        self.stop_rainbow()
        sdk = getattr(self, "_sdk", None)
        if sdk is not None:
            self._sdk = None
            try:
                sdk.close()
            except OSError:
                pass
        proc = getattr(self, "_server_proc", None)
        if proc is not None:
            self._server_proc = None
            try:
                proc.terminate()
            except OSError:
                pass
            threading.Thread(target=self._reap, args=(proc,), daemon=True).start()

    @staticmethod
    def _reap(proc):
        try:
            proc.wait(timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            try:
                proc.kill()
            except OSError:
                pass

    def sync_switches(self):
        """Repaint the device switches from dev_state (no hardware call)."""
        for sw, hid, group in self.switch_rows:
            sw.handler_block(hid)
            sw.set_active(all(self.dev_state.get(d["index"]) for d in group["devices"]))
            sw.handler_unblock(hid)

    def apply_device(self, dev, on):
        if not self.openrgb:
            raise RuntimeError("OpenRGB not installed")
        self._native_applied = False
        args = [self.openrgb, "--noautoconnect", "-d", str(dev["index"])]
        if on:
            if any(m.strip("[]") == "Direct" for m in dev["modes"]):
                args += ["-m", "Direct"]
            args += ["-c", self.on_color_hex]
        elif any(m.strip("[]") == "Off" for m in dev["modes"]):
            args += ["-m", "Off"]
        else:
            if any(m.strip("[]") == "Direct" for m in dev["modes"]):
                args += ["-m", "Direct"]
            args += ["-c", "000000"]
        subprocess.run(args, capture_output=True, text=True)

    def apply_async(self, fn, ok_msg, refresh=True):
        self.toast.add_toast(Adw.Toast(title="Working\u2026", timeout=1))

        def done(err):
            self.toast.add_toast(Adw.Toast(title=str(err) if err else ok_msg, timeout=3))
            if refresh:
                self.refresh()
        run_async(fn, done)

    def do_setup(self):
        syssh = find_support("scripts", "setup-system.sh")
        inst = find_support("install.sh")
        if not syssh and not inst:
            self.toast.add_toast(Adw.Toast(
                title="Setup files not found \u2013 run ./install.sh from the repo", timeout=5))
            return

        def work():
            if syssh:
                if shutil.which("pkexec"):
                    r = subprocess.run(["pkexec", "bash", syssh], capture_output=True, text=True)
                elif shutil.which("sudo"):
                    r = subprocess.run(["sudo", "bash", syssh], capture_output=True, text=True)
                else:
                    raise RuntimeError("need pkexec or sudo for system setup")
                if r.returncode not in (0, 10):
                    raise RuntimeError("system setup failed (see terminal)")
            if inst:
                subprocess.run(["bash", inst, "--skip-system"], capture_output=True, text=True)

        self.toast.add_toast(Adw.Toast(title="Installing\u2026 enter your password", timeout=2))
        self.apply_async(work, "Setup complete (reboot may be required)")

    def show_about(self):
        about = Adw.AboutWindow(transient_for=self, application_name="PC LEDs",
                                application_icon="video-display", version=VERSION,
                                comments="Control PC RGB LEDs (motherboard ARGB + RAM) via OpenRGB.",
                                website="https://github.com/Shahzad-Marth/pc-leds")
        about.set_developers(["Shahzad Marth"])
        about.present()

    # ------------------------------------------------------------ refresh ----
    def refresh(self):
        self.openrgb = find_openrgb()
        for row in self.dev_rows:
            self.dev_group.remove(row)
        self.dev_rows = []
        self.switch_rows = []
        self.devices = list_devices(self.openrgb)
        self._rainbow_plan = None       # device list changed -> reclassify

        if not self.openrgb:
            placeholder = Adw.ActionRow(title="OpenRGB not installed",
                                        subtitle="Use \u201cInstall / Configure\u201d above")
            self.dev_group.add(placeholder)
            self.dev_rows.append(placeholder)
        elif not self.devices:
            placeholder = Adw.ActionRow(title="No devices detected",
                                        subtitle="Check udev rules / permissions")
            self.dev_group.add(placeholder)
            self.dev_rows.append(placeholder)
        else:
            for group in group_devices(self.devices):
                row = Adw.ActionRow(title=group["title"], subtitle=group["subtitle"])
                sw = Gtk.Switch(valign=Gtk.Align.CENTER)
                for dev in group["devices"]:
                    if dev["index"] not in self.dev_state:
                        if self.leds_state is not None:
                            self.dev_state[dev["index"]] = (self.leds_state == "on")
                        else:
                            self.dev_state[dev["index"]] = active_mode(dev["modes"]) != "Off"
                sw.set_active(all(self.dev_state[dev["index"]] for dev in group["devices"]))
                hid = sw.connect("state-set", self._on_group_switch, group)
                row.add_suffix(sw)
                row.set_activatable_widget(sw)
                self.dev_group.add(row)
                self.dev_rows.append(row)
                self.switch_rows.append((sw, hid, group))

        base = self.openrgb or "not installed"
        self.status_row.set_subtitle("%s%s" % (base,
                                 "  \u00b7  %d device(s)" % len(self.devices) if self.devices else ""))


class App(Adw.Application):
    smoke = False

    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_startup(self):
        Adw.Application.do_startup(self)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.PREFER_DARK)

    def do_activate(self):
        if self.smoke:
            Window(self)          # construct the whole UI, but never present it
            print("smoke: UI constructed OK (%d devices)" % len(list_devices(find_openrgb())))
            self.quit()
            return
        win = self.props.active_window or Window(self)
        win.present()


def self_test():
    print("openrgb:", find_openrgb())
    print("leds   :", find_leds())
    print("setup  :", find_support("scripts", "setup-system.sh"))
    for d in list_devices(find_openrgb()):
        print("  [%d] %s (%s) modes=%s zones=%s" %
              (d["index"], d["name"], d["type"], ",".join(d["modes"]), ",".join(d["zones"])))
    return 0


if __name__ == "__main__":
    if "--self-test" in sys.argv:
        sys.exit(self_test())
    if "--version" in sys.argv:
        print("pc-leds-gui %s" % VERSION)
        sys.exit(0)
    if "--smoke" in sys.argv:
        App.smoke = True
        sys.argv = [a for a in sys.argv if a != "--smoke"]
    sys.exit(App().run(sys.argv))
